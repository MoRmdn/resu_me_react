# Firebase web config. Copy to `.env` and fill in from the Firebase console:
# Project settings → Your apps → SDK setup and configuration.
#
# These values ship in the client bundle. They are not server secrets.
# Access control is database.rules.json (and App Check, once enabled).
# `.env` is gitignored so GitHub secret scanning does not flag the API key.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=m0rmdn
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=m0rmdn.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://m0rmdn-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=m0rmdn.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
