# Firebase web config.
#
# Checked in deliberately. These values are not secrets — the Firebase web SDK
# ships every one of them inside the client bundle no matter how they are
# supplied, so hiding them buys nothing. Access control lives in
# database.rules.json and (once enabled) App Check.
#
# They are committed rather than left in .env.local because `output: "export"`
# inlines NEXT_PUBLIC_* at build time, so CI needs them present to produce a
# working bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBdzWnqBLg1XbA_KYbMsBrEUUGYaIB_S_E
NEXT_PUBLIC_FIREBASE_APP_ID=1:107108353240:web:d3b63650476ea3eede03ad
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=107108353240
NEXT_PUBLIC_FIREBASE_PROJECT_ID=m0rmdn
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=m0rmdn.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://m0rmdn-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=m0rmdn.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-1YCV718V1K
