{
  "name": "resu_me_react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/generate-og.mjs",
    "brief": "tsc content/*.ts scripts/content-brief.ts --outDir .brief --module commonjs --target es2022 --moduleResolution node --skipLibCheck && node .brief/scripts/content-brief.js && rm -rf .brief",
    "ingest": "node scripts/ingest-assets.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
